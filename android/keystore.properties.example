# Salin menjadi keystore.properties (file itu diabaikan git) lalu isi.
# Buat kuncinya sekali (keytool ada di JDK / Android Studio):
#   (jalankan di folder android/) keytool -genkeypair -v -keystore uanglapangan-release.jks -alias uanglapangan -keyalg RSA -keysize 2048 -validity 10000
# SIMPAN file .jks & sandinya baik-baik: tanpa kunci yang sama, APK versi berikutnya tidak bisa
# memperbarui aplikasi yang sudah terpasang (harus dicopot dulu, data di HP ikut hilang).
storeFile=uanglapangan-release.jks
storePassword=
keyAlias=uanglapangan
keyPassword=
