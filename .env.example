# ============================================================================================
# UangLapangan — contoh variabel lingkungan (TANPA nilai rahasia).
# Salin ke .env.local (pengembangan) atau isi di Vercel → Project → Settings → Environment
# Variables (produksi). Jangan pernah commit file .env yang berisi nilai asli.
# Buat nilai acak untuk secret:   npm run env:secrets
# Periksa kelengkapan env:        node --env-file=.env.production scripts/check-env.mjs
# Panduan lengkap:                docs/DEPLOY.md
# ============================================================================================

# ---- Database (Turso / libSQL) -------------------------------------------------- WAJIB ----
# Dev: kosongkan → memakai file:./data/uanglapangan.db
# Produksi: alamat database Turso (turso db show <nama> --url) dan token-nya
#           (turso db tokens create <nama>).
DATABASE_URL=libsql://uanglapangan-<akun>.turso.io
DATABASE_AUTH_TOKEN=

# ---- Akun (Better Auth) --------------------------------------------------------- WAJIB ----
# Kunci penanda tangan cookie sesi, minimal 32 karakter acak.
BETTER_AUTH_SECRET=
# Alamat publik aplikasi (juga dipakai untuk tautan atur ulang sandi di email).
BETTER_AUTH_URL=https://uanglapangan.vercel.app

# ---- Sinkron multi-perangkat ---------------------------------------------------- WAJIB ----
# Kunci token sinkron per perangkat, minimal 32 karakter acak.
SYNC_TOKEN_SECRET=

# ---- Backup terjadwal (Vercel Cron) --------------------------------------------- WAJIB ----
# Vercel mengirimnya sebagai "Authorization: Bearer <CRON_SECRET>" ke /api/cron/backup.
CRON_SECRET=

# ---- Google Drive (backup ke Drive pribadi pengguna) ---------------------------- WAJIB ----
# Dari Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Harus terdaftar persis di "Authorized redirect URIs".
GOOGLE_REDIRECT_URI=https://uanglapangan.vercel.app/api/drive/callback
# Kunci enkripsi refresh token Drive di database (AES-256-GCM), minimal 32 karakter acak.
DRIVE_TOKEN_KEY=

# ---- Penyimpanan foto struk & arsip (Cloudflare R2) ----------------- WAJIB di Vercel ----
# Cloudflare dasbor → R2 → buat bucket PRIVAT → Manage R2 API Tokens (Object Read & Write,
# hanya bucket ini). Kosongkan semua → berkas disimpan di folder ./data (hanya untuk dev/VPS).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uanglapangan-struk
# R2_ENDPOINT=             # opsional; bawaan https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_DIR=./data       # opsional; folder driver lokal

# ---- Email (Resend): tautan atur ulang sandi & pemberitahuan backup gagal ------ DISARANKAN ----
# Tanpa ini email tidak terkirim (tautan atur ulang sandi hanya tercetak di log saat dev).
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=UangLapangan <notif@domainanda.id>

# ---- WhatsApp (Fonnte): kode atur ulang sandi akun nomor HP ------------------- DISARANKAN ----
# fonnte.com → Device → hubungkan nomor WA → salin token perangkat.
# Tanpa ini pengguna akun nomor HP tidak bisa menerima kode lupa sandi.
FONNTE_TOKEN=

# ---- Opsional (uji / penyedia lain) ---------------------------------------------------------
# EXCHANGE_RATES_URL=https://api.frankfurter.dev/v1/latest
# FONNTE_API_URL=https://api.fonnte.com/send
# RESEND_API_URL=https://api.resend.com/emails
